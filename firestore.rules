rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global helper primitives
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAuthorizedAdminEmail() {
      return isSignedIn() && (
        request.auth.token.email == 'shukla.mohit52@gmail.com' ||
        request.auth.token.email == 'booksboon17@gmail.com' ||
        request.auth.token.email == 'sgi181069@gmail.com' ||
        request.auth.token.email == 'spiindia181069@gmail.com'
      );
    }

    // Validation blueprints
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email']) &&
        data.uid is string && data.uid.size() <= 128 &&
        data.email is string && data.email.size() <= 128 &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 25)) &&
        (!('role' in data) || (data.role in ['student', 'admin'])) &&
        (!('targetExam' in data) || (data.targetExam is string && data.targetExam.size() <= 100));
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['orderId', 'userId', 'customerEmail', 'totalAmount', 'paymentStatus']) &&
        data.orderId is string && data.orderId.size() <= 64 &&
        data.userId is string && data.userId.size() <= 128 &&
        data.customerEmail is string && data.customerEmail.size() <= 128 &&
        data.totalAmount is number && data.totalAmount >= 0 &&
        data.paymentStatus in ['Paid', 'Pending', 'Failed'] &&
        (!('shippingStatus' in data) || (data.shippingStatus in ['Ordered', 'Dispatched', 'In Transit', 'Out for Delivery', 'Delivered']));
    }

    function isValidTestAttempt(data) {
      return data.keys().hasAll(['attemptId', 'userId', 'testId', 'score']) &&
        data.attemptId is string && data.attemptId.size() <= 64 &&
        data.userId is string && data.userId.size() <= 128 &&
        data.testId is string && data.testId.size() <= 64 &&
        data.score is number && data.score >= 0;
    }

    // Default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Users collection
    match /users/{userId} {
      allow get: if isOwner(userId) || isAuthorizedAdminEmail();
      allow list: if isAuthorizedAdminEmail();
      allow create: if isOwner(userId) && isValidId(userId) && incoming().uid == request.auth.uid && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && incoming().uid == request.auth.uid && isValidUser(incoming());
      allow delete: if isAuthorizedAdminEmail();
    }

    // Orders collection
    match /orders/{orderId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAuthorizedAdminEmail());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAuthorizedAdminEmail());
      allow create: if isSignedIn() && isValidId(orderId) && incoming().userId == request.auth.uid && isValidOrder(incoming());
      allow update: if isAuthorizedAdminEmail();
      allow delete: if isAuthorizedAdminEmail();
    }

    // Test attempts collection
    match /testAttempts/{attemptId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAuthorizedAdminEmail());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAuthorizedAdminEmail());
      allow create: if isSignedIn() && isValidId(attemptId) && incoming().userId == request.auth.uid && isValidTestAttempt(incoming());
      allow update: if isAuthorizedAdminEmail();
      allow delete: if isAuthorizedAdminEmail();
    }
  }
}
