rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global helper primitives
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAuthorizedAdminEmail() {
      return isSignedIn() && (
        request.auth.token.email == 'shukla.mohit52@gmail.com' ||
        request.auth.token.email == 'booksboon17@gmail.com' ||
        request.auth.token.email == 'sgi181069@gmail.com' ||
        request.auth.token.email == 'spiindia181069@gmail.com' ||
        request.auth.token.email == 'archanashuklashukla58@gmail.com'
      );
    }

    // Default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Health and connection probe path
    match /test/{testId} {
      allow read: if true;
    }

    // Users collection: Private student profiles
    match /users/{userId} {
      allow get: if isOwner(userId) || isAuthorizedAdminEmail();
      allow list: if isAuthorizedAdminEmail();
      allow create, update: if isOwner(userId) || isAuthorizedAdminEmail();
      allow delete: if isAuthorizedAdminEmail();
    }

    // Orders collection: BooksBoon physical orders
    match /orders/{orderId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAuthorizedAdminEmail());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAuthorizedAdminEmail());
      allow create: if true;
      allow update, delete: if isAuthorizedAdminEmail();
    }

    // Test attempts collection
    match /testAttempts/{attemptId} {
      allow get, list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAuthorizedAdminEmail());
      allow create: if isSignedIn();
      allow update, delete: if isAuthorizedAdminEmail();
    }

    // Public educational resources: readable by everyone, manageable by authorized administrators
    match /current_affairs/{articleId} {
      allow read: if true;
      allow create, update, delete: if isAuthorizedAdminEmail();
    }

    match /free_pdfs/{pdfId} {
      allow read: if true;
      allow create, update, delete: if isAuthorizedAdminEmail();
    }

    match /video_lectures/{videoId} {
      allow read: if true;
      allow create, update, delete: if isAuthorizedAdminEmail();
    }

    match /test_series/{testId} {
      allow read: if true;
      allow create, update, delete: if isAuthorizedAdminEmail();
    }

    match /books/{bookId} {
      allow read: if true;
      allow create, update, delete: if isAuthorizedAdminEmail();
    }
  }
}
